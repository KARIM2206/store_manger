{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StoreManager",
  "version": "1.0.0",
  "identifier": "com.storemanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "مدير المخزن | نظام إدارة المخزون والمبيعات",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:store.db"]
    }
  }
}
